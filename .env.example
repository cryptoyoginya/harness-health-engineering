# Скопируй в .env и заполни. .env в .gitignore — не коммитится.

# --- Whoop developer app ---
# 1. Заведи app на https://developer.whoop.com → Developer Dashboard.
# 2. Redirect URL зарегистрируй как: http://localhost:7777/callback
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:7777/callback

# --- Telegram bot (тупой сборщик) ---
# Токен от @BotFather (напиши ему /newbot). Бот только собирает сообщения в дневной лог.
TELEGRAM_BOT_TOKEN=
# Оставь пустым на первый запуск: бот пришлёт твой chat_id в ответ на любое сообщение.
# Потом впиши сюда — бот будет принимать только из твоего чата.
TELEGRAM_CHAT_ID=
