# Whoop developer app credentials.
# 1. Заведи app на https://developer.whoop.com → Developer Dashboard.
# 2. Redirect URL зарегистрируй как: http://localhost:7777/callback
# 3. Скопируй этот файл в .env и подставь значения. .env — в .gitignore, не коммитится.

WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Можно не менять (должно совпадать с redirect URL в дашборде):
WHOOP_REDIRECT_URI=http://localhost:7777/callback
